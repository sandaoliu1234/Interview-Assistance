{
  "name": "@hireme/desktop",
  "version": "0.3.43",
  "private": true,
  "description": "Interview Assistance (Browser Dev Mode)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node dev-server.js",
    "dev:electron": "electron . --inspect",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --config",
    "build:mac": "electron-builder --mac --arm64 --config",
    "build:linux": "electron-builder --linux --x64 --config",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.7.7",
    "docx": "^9.5.1",
    "dotenv": "^17.2.4",
    "file-saver": "^2.0.5",
    "iconv-lite": "^0.6.3",
    "koffi": "^2.9.0",
    "mammoth": "^1.11.0",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "qrcode": "^1.5.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "express": "^4.21.2"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "koffi@2.16.3": true
  }
}
